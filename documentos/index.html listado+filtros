                tipo: "Auditorio / Ejecutivo",
                capacidad: 500,
                precioHora: 450,
                disponible: true,
                rating: 4.9,
                ubicación: "Complejo Ferial Cerro",
                imagen: "https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=800&q=80",
                descripcion: "Gran espacio modular de alta capacidad para exposiciones, congresos internacionales y conciertos privados.",
                servicios: ["catering", "audio", "clima", "parking", "wifi"]
            }
        ];

        // DICCIONARIO DE ICONOS DE SERVICIOS
        const serviceMap = {
            catering: { name: "Catering", icon: "fa-utensils" },
            audio: { name: "Audio/Video", icon: "fa-volume-high" },
            clima: { name: "Climatización", icon: "fa-snowflake" },
            parking: { name: "Estacionamiento", icon: "fa-square-p" },
            wifi: { name: "Wi-Fi", icon: "fa-wifi" }
        };

        // ELEMENTOS DOM
        const grid = document.getElementById('salonesGrid');
        const noResults = document.getElementById('noResults');
        const searchInput = document.getElementById('searchInput');
        const typeSelect = document.getElementById('typeSelect');
        const capacityRange = document.getElementById('capacityRange');
        const capacityVal = document.getElementById('capacityVal');
        const priceRange = document.getElementById('priceRange');
        const priceVal = document.getElementById('priceVal');
        const checkAvailableOnly = document.getElementById('checkAvailableOnly');
        const sortBy = document.getElementById('sortBy');
        const resultsCount = document.getElementById('resultsCount');
        const totalCount = document.getElementById('totalCount');
        
        // Modal elements
        const modal = document.getElementById('bookingModal');
        let currentActiveSalon = null;

        // INICIALIZACIÓN
        document.addEventListener('DOMContentLoaded', () => {
            totalCount.textContent = salonesData.length;
            setupEventListeners();
            renderSalones(salonesData);
            setupThemeToggle();
        });

        // REGISTRO DE EVENT LISTENERS DOM
        function setupEventListeners() {
            searchInput.addEventListener('input', filterAndRender);
            typeSelect.addEventListener('change', filterAndRender);
            
            capacityRange.addEventListener('input', (e) => {
                capacityVal.textContent = `${e.target.value} pers.`;
                filterAndRender();
            });

            priceRange.addEventListener('input', (e) => {
                priceVal.textContent = `$${e.target.value}`;
                filterAndRender();
            });

            checkAvailableOnly.addEventListener('change', filterAndRender);
            sortBy.addEventListener('change', filterAndRender);

            document.querySelectorAll('.service-checkbox').forEach(cb => {
                cb.addEventListener('change', filterAndRender);
            });
        }

        // LÓGICA DE FILTRADO Y ORDENAMIENTO DE DATOS
        function filterAndRender() {
            const query = searchInput.value.toLowerCase().trim();
            const selectedType = typeSelect.value;
            const minCap = parseInt(capacityRange.value, 10);
            const maxPrice = parseInt(priceRange.value, 10);
            const availableOnly = checkAvailableOnly.checked;
            
            // Obtener servicios seleccionados
            const selectedServices = Array.from(document.querySelectorAll('.service-checkbox:checked'))
                                          .map(cb => cb.value);

            let filtered = salonesData.filter(salon => {
                // Filtro búsqueda por nombre o ubicación
                const matchName = salon.nombre.toLowerCase().includes(query) || 
                                  salon.ubicación.toLowerCase().includes(query);
                
                // Filtro tipo
                const matchType = (selectedType === 'todos') || (salon.tipo === selectedType);
                
                // Filtro capacidad y precio
                const matchCap = salon.capacidad >= minCap;
                const matchPrice = salon.precioHora <= maxPrice;

                // Filtro disponibilidad
                const matchAvail = !availableOnly || salon.disponible;

                // Filtro servicios (debe incluir TODOS los servicios marcados)
                const matchServices = selectedServices.every(srv => salon.servicios.includes(srv));

                return matchName && matchType && matchCap && matchPrice && matchAvail && matchServices;
            });

            // Ordenamiento
            const sortVal = sortBy.value;
            filtered.sort((a, b) => {
                if (sortVal === 'precio-asc') return a.precioHora - b.precioHora;
                if (sortVal === 'precio-desc') return b.precioHora - a.precioHora;
                if (sortVal === 'capacidad-desc') return b.capacidad - a.capacidad;
                if (sortVal === 'rating-desc') return b.rating - a.rating;
                return a.id - b.id; // Relevancia / ID por defecto
            });

            renderSalones(filtered);
        }

        // RENDERIZADO DE TARJETAS EN EL DOM
        function renderSalones(salones) {
            grid.innerHTML = '';
            resultsCount.textContent = salones.length;

            if (salones.length === 0) {
                noResults.classList.remove('hidden');
                grid.classList.add('hidden');
                return;
            }

            noResults.classList.add('hidden');
            grid.classList.remove('hidden');

            salones.forEach(salon => {
                const card = document.createElement('div');
                card.className = "bg-white dark:bg-slate-800 rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group";

                // Badges de disponibilidad y servicios
                const availBadge = salon.disponible 
                    ? `<span class="bg-emerald-500/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-full backdrop-blur-sm"><i class="fa-solid fa-check mr-1"></i> Disponible</span>`
                    : `<span class="bg-rose-500/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-full backdrop-blur-sm"><i class="fa-solid fa-clock mr-1"></i> Reservado</span>`;

                const servicesHTML = salon.servicios.slice(0, 4).map(s => `
                    <span title="${serviceMap[s]?.name || s}" class="text-slate-400 dark:text-slate-500 text-xs hover:text-emerald-500 transition-colors">
                        <i class="fa-solid ${serviceMap[s]?.icon}"></i>
                    </span>
                `).join(' ');

                card.innerHTML = `
                    <div class="relative h-48 overflow-hidden">
                        <img src="${salon.imagen}" alt="${salon.nombre}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                        <div class="absolute top-3 left-3 flex gap-2">
                            ${availBadge}
                        </div>
                        <div class="absolute top-3 right-3 bg-slate-900/70 backdrop-blur-md text-amber-400 font-bold text-xs px-2.5 py-1 rounded-lg border border-white/10">
                            ${salon.rating} <i class="fa-solid fa-star text-xs"></i>
                        </div>
                    </div>
                    
                    <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                        <div>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">${salon.tipo}</span>
                            <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">${salon.nombre}</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1">
                                <i class="fa-solid fa-location-dot text-slate-400"></i> ${salon.ubicación}
                            </p>
                        </div>

                        <div class="pt-3 border-t border-slate-100 dark:border-slate-700/60 grid grid-cols-2 gap-2 text-xs">
                            <div class="text-slate-600 dark:text-slate-300">
                                <i class="fa-solid fa-users text-emerald-500 mr-1.5"></i>
                                <span class="font-semibold">${salon.capacidad}</span> pers.
                            </div>
                            <div class="text-right font-extrabold text-slate-800 dark:text-slate-100 text-sm">
                                $${salon.precioHora} <span class="text-[10px] font-normal text-slate-400">/ hora</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-2">
                            <div class="flex items-center gap-2">
                                ${servicesHTML}
                            </div>
                            <button onclick="openModal(${salon.id})" class="px-3.5 py-2 bg-slate-100 hover:bg-emerald-600 dark:bg-slate-700 dark:hover:bg-emerald-600 text-slate-700 hover:text-white dark:text-slate-200 text-xs font-semibold rounded-xl transition-all">
                                Ver y Reservar
                            </button>
                        </div>
                    </div>
                `;

                grid.appendChild(card);
            });
        }

        // RESETEAR FILTROS
        function resetFilters() {
            searchInput.value = '';
            typeSelect.value = 'todos';
            capacityRange.value = 0;
            capacityVal.textContent = '0 pers.';
            priceRange.value = 500;
            priceVal.textContent = '$500';
            checkAvailableOnly.checked = false;
            sortBy.value = 'relevancia';

            document.querySelectorAll('.service-checkbox').forEach(cb => cb.checked = false);
            filterAndRender();
            showToast("Filtros restablecidos", "info");
        }

        // LÓGICA DE MODAL & RESERVAS
        function openModal(id) {
            const salon = salonesData.find(s => s.id === id);
            if (!salon) return;

            currentActiveSalon = salon;

            document.getElementById('modalImg').src = salon.imagen;
            document.getElementById('modalTitle').textContent = salon.nombre;
            document.getElementById('modalCategory').textContent = salon.tipo;
            document.getElementById('modalLocation').innerHTML = `<i class="fa-solid fa-location-dot text-emerald-400"></i> ${salon.ubicación}`;
            document.getElementById('modalCapacity').textContent = `${salon.capacidad} personas`;
            document.getElementById('modalPrice').textContent = `$${salon.precioHora} / hr`;
            document.getElementById('modalRating').textContent = `${salon.rating} ★`;
            document.getElementById('modalDescription').textContent = salon.descripcion;

            // Renderizar insignias de servicios en modal
            const servicesContainer = document.getElementById('modalServices');
            servicesContainer.innerHTML = salon.servicios.map(s => `
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 text-xs font-medium border border-emerald-200 dark:border-emerald-800">
                    <i class="fa-solid ${serviceMap[s]?.icon}"></i> ${serviceMap[s]?.name || s}
                </span>
            `).join('');

            // Calcular presupuesto inicial
            calculateTotal();

            // Settear fecha mínima a mañana
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            document.getElementById('bookingDate').min = tomorrow.toISOString().split('T')[0];

            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function calculateTotal() {
            if (!currentActiveSalon) return;
            const hours = parseInt(document.getElementById('bookingHours').value, 10) || 1;
            const total = hours * currentActiveSalon.precioHora;
            document.getElementById('calculatedTotal').textContent = `$${total}`;
        }

        function submitReservation(e) {
            e.preventDefault();
            closeModal();
            showToast("¡Solicitud enviada con éxito! Nos contactaremos a la brevedad.");
        }

        // TOAST NOTIFICATION HELPERS
        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.textContent = msg;
            toastIcon.innerHTML = type === 'success' 
                ? `<i class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>`
                : `<i class="fa-solid fa-circle-info text-blue-400 text-lg"></i>`;

            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        // MODO OSCURO / CLARO
        function setupThemeToggle() {
            const btn = document.getElementById('themeToggleBtn');
            btn.addEventListener('click', () => {
                document.documentElement.classList.toggle('dark');
                const isDark = document.documentElement.classList.contains('dark');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
            });

            // Detectar preferencia guardada o sistema
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }
