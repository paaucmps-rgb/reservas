<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grupo Reservas del Cerro - Salones y Espacios para Eventos</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#16a34a',
                            600: '#15803d',
                            700: '#166534',
                            800: '#14532d',
                            900: '#143c22',
                        },
                        cerro: {
                            light: '#f8fafc',
                            card: '#ffffff',
                            darkBg: '#0f172a',
                            darkCard: '#1e293b'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.05);
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
        }
        .glass-header {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-sans min-h-screen transition-colors duration-300 flex flex-col">

    <!-- Header principal -->
    <header class="sticky top-0 z-30 glass-header bg-white/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800 transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Logo y Marca -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="resetFilters()">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-emerald-600 to-green-500 flex items-center justify-center text-white shadow-lg shadow-emerald-500/20">
                    <i class="fa-solid font-bold fa-mountain-sun text-xl"></i>
                </div>
                <div>
                    <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-emerald-700 to-green-600 dark:from-emerald-400 dark:to-green-300 bg-clip-text text-transparent">
                        Reservas del Cerro
                    </span>
                    <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                        Grupo Eventos & Salones
                    </span>
                </div>
            </div>

            <!-- Acciones rápidas & Modo oscuro -->
            <div class="flex items-center space-x-3 sm:space-x-4">
                <button id="themeToggleBtn" aria-label="Cambiar tema" class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 transition-all">
                    <i class="fa-solid fa-moon dark:hidden"></i>
                    <i class="fa-solid fa-sun hidden dark:block text-amber-400"></i>
                </button>
                <a href="#contacto" class="hidden sm:inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-4 py-2.5 rounded-xl shadow-md shadow-emerald-600/20 transition-all text-sm">
                    <i class="fa-regular fa-envelope"></i>
                    Contacto / Soporte
                </a>
            </div>
        </div>
    </header>

    <!-- Seccion Hero Banner -->
    <section class="relative bg-gradient-to-b from-emerald-900 via-slate-900 to-slate-900 text-white py-14 sm:py-20 px-4 overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#34d399_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <span class="inline-block py-1 px-3 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-semibold mb-4 tracking-wide uppercase">
                <i class="fa-solid fa-sparkles mr-1"></i> Encuentra el lugar perfecto para tu evento
            </span>
            <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-4 leading-tight">
                Salones de Eventos <span class="text-emerald-400">Grupo del Cerro</span>
            </h1>
            <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto font-light leading-relaxed">
                Bodas, conferencias, cumpleaños y eventos corporativos. Explora y reserva nuestras exclusivas instalaciones con filtros inteligentes en tiempo real.
            </p>
        </div>
    </section>

    <!-- Contenido Principal: Filtros y Tarjetas -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            
            <!-- PANEL DE FILTROS (Sidebar en desktop, colapsable en móvil) -->
            <aside class="lg:col-span-1">
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700/80 shadow-sm sticky top-24">
                    
                    <!-- Header Filtros -->
                    <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100 dark:border-slate-700">
                        <div class="flex items-center gap-2 font-bold text-slate-800 dark:text-slate-100 text-lg">
                            <i class="fa-solid fa-sliders text-emerald-600 dark:text-emerald-400"></i>
                            <span>Filtros de Búsqueda</span>
                        </div>
                        <button onclick="resetFilters()" class="text-xs text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                            Limpiar todo
                        </button>
                    </div>

                    <form id="filterForm" onsubmit="event.preventDefault();" class="space-y-5">
                        
                        <!-- 1. Búsqueda por Nombre -->
                        <div>
                            <label for="searchInput" class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                                Buscar por nombre
                            </label>
                            <div class="relative">
                                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                                <input type="text" id="searchInput" placeholder="Ej. Gran Mirador, Suite..." class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all">
                            </div>
                        </div>

                        <!-- 2. Tipo de Salón -->
                        <div>
                            <label for="typeSelect" class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                                Tipo de Espacio
                            </label>
                            <select id="typeSelect" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all">
                                <option value="todos">Todos los tipos</option>
                                <option value="Salón Principal">Salón Principal</option>
                                <option value="Quinta / Jardín">Quinta / Jardín</option>
                                <option value="Terraza Lounge">Terraza Lounge</option>
                                <option value="Auditorio / Ejecutivo">Auditorio / Ejecutivo</option>
                            </select>
                        </div>

                        <!-- 3. Capacidad Mínima -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="capacityRange" class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                    Capacidad Mínima
                                </label>
                                <span id="capacityVal" class="text-xs font-semibold bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 px-2 py-0.5 rounded-md">0 pers.</span>
                            </div>
                            <input type="range" id="capacityRange" min="0" max="500" step="25" value="0" class="w-full accent-emerald-600 cursor-pointer">
                        </div>

                        <!-- 4. Precio Máximo por Hora -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="priceRange" class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                    Precio Máx / hora
                                </label>
                                <span id="priceVal" class="text-xs font-semibold bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 px-2 py-0.5 rounded-md">$500</span>
                            </div>
                            <input type="range" id="priceRange" min="50" max="500" step="25" value="500" class="w-full accent-emerald-600 cursor-pointer">
                        </div>

                        <!-- 5. Disponibilidad -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                                Estado
                            </label>
                            <div class="flex items-center space-x-4 text-xs font-medium">
                                <label class="inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="checkAvailableOnly" class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                    <span class="ml-2 text-slate-700 dark:text-slate-300">Solo disponibles</span>
                                </label>
                            </div>
                        </div>

                        <!-- 6. Servicios e Instalaciones (Checkboxes) -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                                Servicios Incluidos
                            </label>
                            <div class="space-y-2 text-xs">
                                <label class="flex items-center cursor-pointer text-slate-600 dark:text-slate-300 hover:text-emerald-600">
                                    <input type="checkbox" value="catering" class="service-checkbox rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                    <span class="ml-2 flex items-center gap-1.5"><i class="fa-solid fa-utensils text-slate-400"></i> Servicio Catering</span>
                                </label>
                                <label class="flex items-center cursor-pointer text-slate-600 dark:text-slate-300 hover:text-emerald-600">
                                    <input type="checkbox" value="audio" class="service-checkbox rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                    <span class="ml-2 flex items-center gap-1.5"><i class="fa-solid fa-volume-high text-slate-400"></i> Audio & Luces</span>
                                </label>
                                <label class="flex items-center cursor-pointer text-slate-600 dark:text-slate-300 hover:text-emerald-600">
                                    <input type="checkbox" value="clima" class="service-checkbox rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                    <span class="ml-2 flex items-center gap-1.5"><i class="fa-solid fa-snowflake text-slate-400"></i> Climatización/A.C.</span>
                                </label>
                                <label class="flex items-center cursor-pointer text-slate-600 dark:text-slate-300 hover:text-emerald-600">
                                    <input type="checkbox" value="parking" class="service-checkbox rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                    <span class="ml-2 flex items-center gap-1.5"><i class="fa-solid fa-square-p text-slate-400"></i> Estacionamiento</span>
                                </label>
                                <label class="flex items-center cursor-pointer text-slate-600 dark:text-slate-300 hover:text-emerald-600">
                                    <input type="checkbox" value="wifi" class="service-checkbox rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                    <span class="ml-2 flex items-center gap-1.5"><i class="fa-solid fa-wifi text-slate-400"></i> Wi-Fi Alta Velocidad</span>
                                </label>
                            </div>
                        </div>

                    </form>
                </div>
            </aside>

            <!-- LISTADO DE RESULTADOS -->
            <section class="lg:col-span-3">
                <!-- Barra superior de conteo y ordenamiento -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-6 border-b border-slate-200 dark:border-slate-800 gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">
                            Espacios Disponibles
                        </h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            Mostrando <span id="resultsCount" class="font-bold text-emerald-600 dark:text-emerald-400">0</span> de <span id="totalCount">0</span> salones
                        </p>
                    </div>

                    <!-- Ordenamiento -->
                    <div class="flex items-center space-x-2 text-xs">
                        <label for="sortBy" class="text-slate-500 dark:text-slate-400 font-medium whitespace-nowrap">Ordenar por:</label>
                        <select id="sortBy" class="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="relevancia">Destacados</option>
                            <option value="precio-asc">Precio: Menor a Mayor</option>
                            <option value="precio-desc">Precio: Mayor a Menor</option>
                            <option value="capacidad-desc">Mayor Capacidad</option>
                            <option value="rating-desc">Mejor Calificados</option>
                        </select>
                    </div>
                </div>

                <!-- Contenedor Grid donde se inyectan los salones mediante JS -->
                <div id="salonesGrid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Dinámico vía Javascript -->
                </div>

                <!-- Mensaje de no resultados (Oculto por defecto) -->
                <div id="noResults" class="hidden text-center py-16 bg-white dark:bg-slate-800 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 p-8">
                    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-400">
                        <i class="fa-solid fa-magnifying-glass text-2xl"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-700 dark:text-slate-200 mb-1">No se encontraron salones</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 max-w-xs mx-auto mb-4">Intenta ajustar los filtros de precio, servicios o búsqueda para ver más opciones.</p>
                    <button onclick="resetFilters()" class="text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl transition-all">
                        Restablecer Filtros
                    </button>
                </div>
            </section>
        </div>
    </main>

    <!-- MODAL DE DETALLES Y RESERVA -->
    <div id="bookingModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm overflow-y-auto">
        <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-slate-200 dark:border-slate-700 relative my-8">
            
            <!-- Botón cerrar modal -->
            <button onclick="closeModal()" class="absolute top-4 right-4 z-10 w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-500 hover:text-slate-800 dark:hover:text-slate-100 flex items-center justify-center transition-all">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <!-- Imagen del Header del Modal -->
            <div class="relative h-56 sm:h-64 w-full overflow-hidden rounded-t-2xl">
                <img id="modalImg" src="" alt="Salon" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/30 to-transparent"></div>
                <div class="absolute bottom-4 left-6 right-6 text-white">
                    <span id="modalCategory" class="text-xs uppercase font-bold tracking-widest text-emerald-400 bg-emerald-950/80 px-2.5 py-1 rounded-md border border-emerald-500/30">
                        Categoría
                    </span>
                    <h3 id="modalTitle" class="text-2xl font-black mt-2 leading-tight">Nombre del Salón</h3>
                    <p id="modalLocation" class="text-xs text-slate-300 flex items-center gap-1 mt-1">
                        <i class="fa-solid fa-location-dot text-emerald-400"></i> Ubicación
                    </p>
                </div>
            </div>

            <!-- Cuerpo del Modal -->
            <div class="p-6 space-y-6">
                <!-- Características clave -->
                <div class="grid grid-cols-3 gap-3 p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl text-center border border-slate-100 dark:border-slate-800">
                    <div>
                        <span class="block text-[10px] uppercase font-bold text-slate-400">Capacidad</span>
                        <span id="modalCapacity" class="text-sm font-bold text-slate-700 dark:text-slate-200">0 pers</span>
                    </div>
                    <div>
                        <span class="block text-[10px] uppercase font-bold text-slate-400">Precio / Hora</span>
                        <span id="modalPrice" class="text-sm font-bold text-emerald-600 dark:text-emerald-400">$0</span>
                    </div>
                    <div>
                        <span class="block text-[10px] uppercase font-bold text-slate-400">Calificación</span>
                        <span id="modalRating" class="text-sm font-bold text-amber-500">4.8 ★</span>
                    </div>
                </div>

                <!-- Descripción -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Descripción</h4>
                    <p id="modalDescription" class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                        Descripción detallada del espacio...
                    </p>
                </div>

                <!-- Servicios Disponibles -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Servicios Incluidos</h4>
                    <div id="modalServices" class="flex flex-wrap gap-2">
                        <!-- Inyectado JS -->
                    </div>
                </div>

                <hr class="border-slate-100 dark:border-slate-700">

                <!-- Formulario Simulador de Reserva -->
                <div>
                    <h4 class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-3 flex items-center gap-2">
                        <i class="fa-regular fa-calendar-check text-emerald-600"></i>
                        Cotizar y Solicitar Reserva
                    </h4>
                    
                    <form id="reservationForm" onsubmit="submitReservation(event)" class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Fecha del Evento</label>
                                <input type="date" required id="bookingDate" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Horas estimadas</label>
                                <input type="number" id="bookingHours" min="2" max="24" value="4" oninput="calculateTotal()" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Tu Nombre</label>
                                <input type="text" required placeholder="Juan Pérez" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Correo Electrónico</label>
                                <input type="email" required placeholder="correo@ejemplo.com" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                        </div>

                        <!-- Resumen Presupuesto -->
                        <div class="bg-emerald-50 dark:bg-emerald-950/40 p-4 rounded-xl border border-emerald-200 dark:border-emerald-900/50 flex justify-between items-center">
                            <div>
                                <span class="block text-xs text-emerald-800 dark:text-emerald-300 font-medium">Presupuesto Estimado</span>
                                <span class="text-[10px] text-emerald-600 dark:text-emerald-400">*Sujeto a confirmación según servicios extra</span>
                            </div>
                            <span id="calculatedTotal" class="text-xl font-black text-emerald-700 dark:text-emerald-300">$0</span>
                        </div>

                        <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-paper-plane"></i>
                            Enviar Solicitud de Reserva
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Notificación Toast -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-slate-900 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 border border-slate-700">
            <div id="toastIcon" class="text-emerald-400"><i class="fa-solid fa-circle-check"></i></div>
            <span id="toastMsg" class="text-xs font-medium">Acción completada</span>
        </div>
    </div>

    <!-- Footer -->
    <footer id="contacto" class="bg-slate-900 text-slate-400 pt-12 pb-8 border-t border-slate-800 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
            <div>
                <div class="flex items-center space-x-2 text-white font-bold text-lg mb-3">
                    <i class="fa-solid fa-mountain-sun text-emerald-500"></i>
                    <span>Grupo Reservas del Cerro</span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">
                    La mejor red de espacios para eventos corporativos, sociales y privados. Calidad, servicio y ubicaciones estratégicas en la región del Cerro.
                </p>
            </div>
            <div>
                <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-3">Contacto & Atención</h4>
                <ul class="space-y-2 text-xs">
                    <li class="flex items-center gap-2"><i class="fa-solid fa-phone text-emerald-500"></i> +54 (011) 4567-8900</li>
                    <li class="flex items-center gap-2"><i class="fa-solid fa-envelope text-emerald-500"></i> contacto@reservasdelcerro.com</li>
                    <li class="flex items-center gap-2"><i class="fa-solid fa-location-dot text-emerald-500"></i> Av. Del Cerro 1450, Sector Residencial</li>
                </ul>
            </div>
            <div>
                <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-3">Horario de Administración</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-2">
                    Lunes a Viernes: 09:00 - 19:00 hs<br>
